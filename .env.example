# Transport the browser should use.
#   websocket → default. Requires a host that keeps a long-lived Node process
#               (local dev, Render, Fly, Railway, a container anywhere).
#   sse       → Server-Sent Events + POST fallback. Use on Vercel and other
#               serverless platforms, which cannot hold a WebSocket open.
# Leaving it unset means "try WebSocket, fall back to SSE automatically".
NEXT_PUBLIC_REALTIME_TRANSPORT=websocket

# Point the browser at a WebSocket endpoint on another origin (e.g. the Next app
# on Vercel talking to a small WS service elsewhere). Unset = same origin.
# NEXT_PUBLIC_WS_URL=wss://your-ws-host.example.com/api/ws

# Port for the custom server. Hosts usually inject this themselves.
PORT=3000
